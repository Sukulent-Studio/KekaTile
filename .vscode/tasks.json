{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Format current file",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/format.sh",
      "args": ["${file}"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}
